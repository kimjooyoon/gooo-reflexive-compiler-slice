package reflexive
namespace reflexive

entity SourceGraph id "gooo://reflexive/compiler/source-graph"
entity ParsedSource id "gooo://reflexive/compiler/parsed-source"
entity SemanticIR id "gooo://reflexive/compiler/semantic-ir"
entity GeneratedBackend id "gooo://reflexive/compiler/generated-backend"
entity Evidence id "gooo://reflexive/compiler/evidence"

# Generated by scripts/apply-split-candidate.sh from the immutable Gooo delta-forge bundle.
# candidate_digest=sha256:4edd900ea94b1cb461b27d61fb06e72993424eb8ad424b82ac19b78b59318bdb bundle_digest=sha256:49244a778d6e80c67bb5fb0b99342873ba987916b14febb500524a26a5af3490 delta_digest=sha256:826a90daaf19fb0f0b0b51af89c53150219ca624331905a4c913e329b085a6e6
# retired_cell=cell.normalize-source.coarse added_cells=cell.normalize-source.parse-source+cell.normalize-source.validate-stable-ids
# topology reflexive.normalize.v2
# precedence REFUTED > UNKNOWN > CLOSED
# acceptance CLOSED UNKNOWN REFUTED
# rollback RETAIN_BASELINE
# authority SOURCE_GOOO_GRAPH
# split NormalizeSource -> ParseSource + ValidateStableIDs
# edge ParseSource -> ValidateStableIDs : ParsedSource
# edge ValidateStableIDs -> EmitBackend : SemanticIR
# edge ValidateStableIDs -> VerifyReplay : SemanticIR

activity ParseSource(SourceGraph) -> ParsedSource computes "reflexive.normalize:v1;input=GOOO;declarations=entity,activity;stable_id=declared-or-namespace-activity-name;normal_form=sort-by-stable-id;duplicate=REFUTED;missing=UNKNOWN;required_entity=gooo://reflexive/input/required;split=ParseSource+ValidateStableIDs"
activity ValidateStableIDs(ParsedSource) -> SemanticIR computes "reflexive.validate-stable-ids:v1;input=PARSED_SOURCE;duplicate=REFUTED;missing=UNKNOWN"
activity EmitBackend(SemanticIR) -> GeneratedBackend computes "reflexive.backend-go:v1;authority=SOURCE_GOOO_GRAPH;artifact=BACKEND_ONLY;binding=semantic-ir"
activity VerifyReplay(SemanticIR) -> Evidence computes "reflexive.replay:v1;input=GENERATED_SEMANTIC_IR;compare=CANONICAL_DIGEST;rollback=RETAIN_BASELINE"
